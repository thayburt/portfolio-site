<span class="keyword" data-keyword>
    <span class="keyword-display"><slot name="display">{Astro.props.text}</slot></span>
    <span class="popup-anchor">
        <span class="popup">
            (<slot />)
        </span>
    </span>
</span>

<style>
    .keyword {
        position: relative;
        display: inline-block;
        cursor: help;
    }

    .keyword-display {
        color: var(--primary-accent);
        font-weight: bold;
    }

    .keyword .popup-anchor {
        position: absolute;
        left: 50%;
        right: auto;
        top: 100%;
        height: auto;
        z-index: 100;
        pointer-events: none;
        transform: translateX(-50%);
        width: max-content;
    }

    .keyword .popup {
        visibility: hidden;
        opacity: 0;
        width: max-content;
        max-width: calc(100vw - 2rem); /* CSS-only safety constraint */
        background-color: #1a1a1a;
        color: #e0e0e0;
        padding: 0.5rem;
        border: 1px solid #444;
        position: relative;
        display: block;
        transition: opacity 0.2s ease-in-out;
        pointer-events: none;
    }

    .keyword:hover .popup {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
    }

    .keyword:hover .keyword-display {
        color: var(--primary-accent-hover);
    }

    /* Desktop: remove max-width constraint */
    @media (min-width: 1000px) {
        .keyword .popup {
            max-width: none;
        }
    }
</style>

<script>
    // Progressive enhancement: clamp popup position to container bounds
    function clampPopupPosition(keyword: HTMLElement) {
        const popup = keyword.querySelector('.popup') as HTMLElement | null;
        const popupAnchor = keyword.querySelector('.popup-anchor') as HTMLElement | null;
        const container = keyword.closest('.container') as HTMLElement | null;
        
        if (!popup || !popupAnchor || !container) return;
        
        const containerRect = container.getBoundingClientRect();
        const safetyMargin = 16; // 1rem safety margin from container edges
        
        // Ensure popup doesn't exceed container width
        popup.style.maxWidth = `${containerRect.width - (safetyMargin * 2)}px`;
        
        // Reset to centered position to measure
        popupAnchor.style.left = '50%';
        popupAnchor.style.right = 'auto';
        popupAnchor.style.transform = 'translateX(-50%)';
        
        // Get positions after reset
        const popupRect = popup.getBoundingClientRect();
        
        // Calculate necessary shift to stay within container bounds
        let shift = 0;
        if (popupRect.left < containerRect.left + safetyMargin) {
            shift = (containerRect.left + safetyMargin) - popupRect.left;
        } else if (popupRect.right > containerRect.right - safetyMargin) {
            shift = (containerRect.right - safetyMargin) - popupRect.right;
        }
        
        // Apply shift if necessary, maintaining centering where possible
        if (shift !== 0) {
            popupAnchor.style.transform = `translateX(calc(-50% + ${shift}px))`;
        }
    }
    
    // Initialize event listeners and perform initial clamp
    function initKeywords() {
        const keywords = document.querySelectorAll<HTMLElement>('[data-keyword]');
        
        keywords.forEach(keyword => {
            // Initial clamp to prevent layout overflow
            clampPopupPosition(keyword);
            
            // Re-clamp on interaction in case of dynamic layout changes
            keyword.addEventListener('mouseenter', () => clampPopupPosition(keyword));
            keyword.addEventListener('touchstart', () => clampPopupPosition(keyword), { passive: true });
        });

        // Re-clamp all on window resize
        window.addEventListener('resize', () => {
            keywords.forEach(keyword => clampPopupPosition(keyword));
        }, { passive: true });
    }
    
    // Initial load
    initKeywords();
    
    // Re-initialize after view transitions
    document.addEventListener('astro:page-load', initKeywords);
</script>
