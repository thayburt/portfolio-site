---
interface Props {
	text?: string;
	tabindex?: string | number;
}

const { text, tabindex = "0" } = Astro.props;

// Generate a random ID so we can link aria-describedby to the popup tooltip
const popupId = `keyword-popup-${crypto.randomUUID()}`;
---
<span class="keyword" data-keyword tabindex={tabindex} aria-describedby={popupId}>
    <span class="keyword-display"><slot name="display">{text}</slot></span>
    <span class="popup-anchor">
        <span class="popup" id={popupId} role="tooltip">
            (<slot />)
        </span>
    </span>
</span>

<style>
    .keyword {
        position: relative;
        display: inline-block;
        cursor: help;
        outline: none;
        border-radius: 0.2rem;
        transition: box-shadow 0.2s;
    }

    .keyword:focus-visible {
        box-shadow: 0 0 0 2px var(--primary-accent);
    }

    .keyword-display {
        color: var(--primary-accent);
        font-weight: bold;
    }

    .keyword .popup-anchor {
        position: absolute;
        left: 50%;
        right: auto;
        top: 100%;
        height: auto;
        z-index: 100;
        pointer-events: none;
        transform: translateX(-50%);
        width: max-content;
    }

    .keyword .popup {
        visibility: hidden;
        opacity: 0;
        width: max-content;
        max-width: calc(100vw - 2rem); /* CSS-only safety constraint */
        background-color: #1a1a1a;
        color: #e0e0e0;
        padding: 0.5rem;
        border: 1px solid #444;
        position: relative;
        display: block;
        transition: opacity 0.2s ease-in-out;
        pointer-events: none;

        /* Reset font styles to "normal" regardless of parent context */
        font-family: "Spectral", serif;
        font-size: 1rem;
        font-weight: normal;
        text-transform: none;
        line-height: 1.4;
    }

    .keyword:hover .popup,
    .keyword:focus-within .popup,
    :global(a:focus-within) .keyword .popup {
        visibility: visible;
        opacity: 1;
        pointer-events: auto;
    }

    .keyword:hover .keyword-display,
    .keyword:focus-within .keyword-display,
    :global(a:focus-within) .keyword .keyword-display {
        color: var(--primary-accent-hover);
    }

    /* Desktop: remove max-width constraint */
    @media (min-width: 1000px) {
        .keyword .popup {
            max-width: none;
        }
    }
</style>

<script>
    type QueryResult = HTMLElement | null;
    // Progressive enhancement: clamp popup position to container bounds
    function clampPopupPosition(keyword: HTMLElement) {
        const popup: QueryResult | null = keyword.querySelector('.popup');
        const popupAnchor: QueryResult = keyword.querySelector('.popup-anchor');
        const container: QueryResult = keyword.closest('.container');
        
        if (!popup || !popupAnchor || !container) return;
        
        const containerRect = container.getBoundingClientRect();
        const safetyMargin = 16; // 1rem safety margin from container edges
        
        // Ensure popup doesn't exceed container width
        popup.style.maxWidth = `${containerRect.width - (safetyMargin * 2)}px`;
        
        // Reset to centered position to measure
        popupAnchor.style.left = '50%';
        popupAnchor.style.right = 'auto';
        popupAnchor.style.transform = 'translateX(-50%)';
        
        // Get positions after reset
        const popupRect = popup.getBoundingClientRect();
        
        // Calculate necessary shift to stay within container bounds
        let shift = 0;
        if (popupRect.left < containerRect.left + safetyMargin) {
            shift = (containerRect.left + safetyMargin) - popupRect.left;
        } else if (popupRect.right > containerRect.right - safetyMargin) {
            shift = (containerRect.right - safetyMargin) - popupRect.right;
        }
        
        // Apply shift if necessary, maintaining centering where possible
        if (shift !== 0) {
            popupAnchor.style.transform = `translateX(calc(-50% + ${shift}px))`;
        }
    }
    
    // Initialize event listeners and perform initial clamp
    function initKeywords() {
        const keywords = document.querySelectorAll<HTMLElement>('[data-keyword]');
        
        keywords.forEach(keyword => {
            // Initial clamp to prevent layout overflow
            clampPopupPosition(keyword);
            
            // Re-clamp on interaction in case of dynamic layout changes
            keyword.addEventListener('mouseenter', () => clampPopupPosition(keyword));
            keyword.addEventListener('touchstart', () => clampPopupPosition(keyword), { passive: true });
        });

        window.addEventListener('resize', () => {
            keywords.forEach((keyword) => {
				clampPopupPosition(keyword);
			});
        }, { passive: true });
    }
    
    // Initial load
    initKeywords();
    // Reload on transition
    document.addEventListener('astro:page-load', initKeywords);
</script>
