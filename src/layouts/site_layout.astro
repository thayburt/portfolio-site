---
import { ClientRouter } from "astro:transitions";
import type { Graph } from "schema-dts";
import { personJsonLd } from "@/data/person";
import { profilePageJsonLd } from "@/data/profile-page";
import { websiteJsonLd } from "@/data/website";
import { serializeJsonLd } from "@/utils/jsonld";
import "../styles/global.css";
import "../styles/torch.css";
const { description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const structuredDataJsonLd: Graph = {
    "@context": "https://schema.org",
    "@graph": [personJsonLd, websiteJsonLd, profilePageJsonLd],
};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="canonical" href={canonicalURL} />
        <link rel="icon" sizes="any" href="/favicon.ico" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="apple-touch-icon"
            type="image/png"
            href="/portfolio-icon-180.png"
        />
        <link rel="manifest" href="/manifest.webmanifest" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link
            rel="alternate"
            type="application/ld+json"
            href="/person.jsonld"
            title="Thayen Burtenshaw structured data"
        />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        {description && <meta name="description" content={description} />}
        <title>Thayen | Software Developer</title>
        <script type="application/ld+json" set:html={serializeJsonLd(structuredDataJsonLd)} is:inline />
        <ClientRouter />
    </head>

    <body>
        <div class="torch-lights" aria-hidden="true">
            <div class="torch-light torch-light-left"></div>
            <div class="torch-light torch-light-right"></div>
        </div>
        <div class="container parchment">
            <slot />
        </div>
    </body>
</html>
