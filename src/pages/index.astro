---
import { Icon } from "astro-icon/components";
import Keyword from "@/components/keyword.astro";
import SiteLayout from "@/layouts/site_layout.astro";
---

<SiteLayout
  description="Portfolio of Thayen, a Software Engineer and Fanshawe Graduate."
>
  <header>
    <h1>
      <Keyword>
        <Fragment slot="display">Thayen Burtenshaw</Fragment>
        thuh-AY-en
      </Keyword>
    </h1>
    <p>Software developer with a focus on systems and tooling. I build my own tools, run Linux, and tend to go further into topics than strictly necessary.</p>
    <div>Ontario, Canada</div>
    <address>
      <a
        href="https://github.com/N0tAI"
        aria-label="GitHub"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Keyword tabindex="-1" role="none">
          <Fragment slot="display"><Icon name="mdi:github" /></Fragment>
          GitHub
        </Keyword>
      </a>
      <a
        href="https://www.linkedin.com/in/thayen"
        aria-label="LinkedIn"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Keyword tabindex="-1" role="none">
          <Fragment slot="display"><Icon name="mdi:linkedin" /></Fragment>
          LinkedIn
        </Keyword>
      </a>
      <a
        href="mailto:me@thayen.dev"
        aria-label="Email"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Keyword tabindex="-1" role="none">
          <Fragment slot="display"><Icon name="mdi:email" /></Fragment>
          Email
        </Keyword>
      </a>
      <!--<a
        href="/resume.pdf"
        title="Resume"
        aria-label="Resume"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Keyword tabindex="-1">
          <Fragment slot="display"><Icon name="mdi:file-document" /></Fragment>
          Resume
        </Keyword>
      </a>-->
    </address>
  </header>
  <main>
    <section id="skills" aria-labelledby="skills-heading">
      <h2 id="skills-heading">Skills</h2>
      <article>
        <ul>
          <li>
            <strong>Languages:</strong>
            <Keyword>
              <Fragment slot="display">C#</Fragment>
              ASP.NET Programming
            </Keyword>,
            <Keyword>
              <Fragment slot="display">Python</Fragment>
              Scripting & Automation
            </Keyword>,
            <Keyword>
              <Fragment slot="display">Java</Fragment>
              Object Oriented Programming
            </Keyword>,
            <Keyword>
              <Fragment slot="display">C++</Fragment>
              Object Oriented Programming
            </Keyword>,
            <Keyword>
              <Fragment slot="display">C</Fragment>
              Operating System Fundamentals
            </Keyword>,
            <Keyword>
              <Fragment slot="display">JavaScript/Typescript</Fragment>
              Full Stack Web Development
            </Keyword>,
            <Keyword>
              <Fragment slot="display">COBOL</Fragment>
              System Z Programming
            </Keyword>,
            <Keyword>
              <Fragment slot="display">Clojure</Fragment>
              Powernoodle Co-op
            </Keyword>,
            <Keyword>
              <Fragment slot="display">PHP</Fragment>
              Secure Computing & Web Security
            </Keyword>
          </li>
          <li>
            <strong>Web:</strong> ASP.NET Core, Angular, Vue, React
          </li>
          <li>
            <strong>Data:</strong> PostgreSQL, MongoDB, SQL Server, MySQL, Kafka
          </li>
          <li>
            <strong>Concepts:</strong> Object-oriented development, Android, Machine Learning, GenAI, Agile
          </li>
        </ul>
      </article>
    </section>
    <section id="experience" aria-labelledby="experience-heading">
      <h2 id="experience-heading">Experience</h2>
      <article>
        <h3>
          <Keyword>
            <Fragment slot="display">Quality Assurance Analyst Co-op</Fragment>
            <time datetime="P4M">Jan 2023 to Apr 2023</time>
          </Keyword>
        </h3>
        <p>At <strong>Carfax Canada</strong></p>
        <ul>
          <li>Identified an <strong>access control bypass</strong> for licensed assets requiring EULA acceptance</li>
          <li>Worked with development to implement <strong>server-side validation</strong></li>
          <li>Identified and flagged software flaws and vulnerabilities</li>
          <li>Collaborated on establishing time estimations for client requests</li>
          <li>Wrote <strong>detailed reports</strong> on testing, problems, and reproduction</li>
          <li>Participated in an <strong>Agile Development</strong> cycle</li>
        </ul>
      </article>
      <article>
        <h3>
          <Keyword>
            <Fragment slot="display">Co-op Student</Fragment>
            <time datetime="P6M">Jan 2019 to Jun 2019</time>
          </Keyword>
        </h3>
        <p>At <strong>Powernoodle</strong></p>
        <ul>
          <li>Learned <strong>Clojure</strong> in 8 weeks to build a live data analysis web app</li>
          <li>Integrated application with <strong>Kafka</strong> backend</li>
          <li>Improved product quality through weekly <strong>code reviews</strong></li>
          <li>Engaged in weekly <strong>Quality Assurance</strong> sessions to identify bugs</li>
          <li>Participated in an <strong>Agile Development</strong> cycle</li>
        </ul>
      </article>
      <article>
        <h3>
          <Keyword>
            <Fragment slot="display">Team Member</Fragment>
            <time datetime="2023-08-01">Aug 2023 to Current</time>
          </Keyword>
        </h3>
        <p>At <Keyword><Fragment slot="display"><strong>M.C. Moore Holdings LTD</strong></Fragment>Tim Hortons</Keyword></p>
        <ul>
          <li>Excelled in a <strong>fast-paced environment</strong>, maintaining high service standards under pressure</li>
          <li>Collaborated with the team to ensure safety compliance and operational efficiency</li>
        </ul>
      </article>
    </section>
    <section id="education" aria-labelledby="education-heading">
      <h2 id="education-heading">Education</h2>
      <article>
        <h3>Fanshawe College</h3>
        <p>
          <strong>Computer Programming and Analysis</strong> (Advanced Diploma)
        </p>
        <p>
          Graduated: <strong
            ><time datetime="2025-12-20">December 2025</time></strong
          >
        </p>
        <p>
          GPA: <Keyword
            ><Fragment slot="display"><strong>3.32/4.2</strong></Fragment
            >79.0%</Keyword
          >
        </p>
        <ul>
          <li>Awarded the <strong>Dean's Honour Roll</strong></li>
          <li>
            Specialized in
            <Keyword>
              <Fragment slot="display"><strong>Security</strong></Fragment>
              A+ in Secure Computing
            </Keyword>,
            <Keyword>
              <Fragment slot="display"><strong>Architecture</strong></Fragment>
              A+ in Software Design Patterns
            </Keyword>, and
            <Keyword>
              <Fragment slot="display"><strong>Project Management</strong></Fragment>
              A+ in Managing Software Projects
            </Keyword>
          </li>
          <li>Object-oriented development</li>
          <li>Full-stack web development</li>
          <li>Mobile development with <strong>Android</strong></li>
          <li>Database development</li>
          <li>Exposure to <strong>Machine Learning</strong> and <strong>GenAI</strong></li>
        </ul>
      </article>
      <article>
        <h3>Stratford Central Secondary School</h3>
        <p>Graduated: <strong><time datetime="2020-06-20">June 2020</time></strong></p>
        <ul>
          <li>Project owner and team leader in <strong>Computer Science</strong> group projects</li>
          <li>Assisted students with Computer Science projects</li>
        </ul>
      </article>
    </section>
    <!--
    <section id="projects">
      <h2>Projects</h2>
    </section>
    -->
  </main>
</SiteLayout>

<style>
  ul {
    list-style-type: lower-roman;
    list-style-position: outside;
    margin-left: 1.5rem;
  }
  li {
    margin-bottom: 0.5rem;
  }
  li::marker {
    color: var(--primary-accent);
  }
  address {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    font-style: normal;
  }
  address a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    min-height: 44px;
    min-width: 44px;
    border-radius: 50%;
    transition: background-color 0.2s;
    line-height: 1;
  }
  address a:hover {
    background-color: rgba(122, 87, 30, 0.1);
    text-decoration: none;
  }
  address a svg {
    font-size: 1.5rem;
  }
</style>
